# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/erp_biomassa"

# Servidor
PORT=3333

# Autenticação — troque por um valor longo e aleatório em produção
# (ex: openssl rand -hex 32). No Render isso é gerado automaticamente.
JWT_SECRET="troque_por_um_valor_aleatorio_longo"

# Provedor de emissão fiscal (Focus NFe)
# Comece com a URL de homologação para testar sem gerar documentos reais.
FOCUS_NFE_BASE_URL="https://homologacao.focusnfe.com.br"
FOCUS_NFE_TOKEN="coloque_aqui_o_token_do_provedor"
