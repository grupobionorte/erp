# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/erp_biomassa"

# Servidor
PORT=3333

# Autenticação — troque por um valor longo e aleatório em produção
# (ex: openssl rand -hex 32). No Render isso é gerado automaticamente.
JWT_SECRET="troque_por_um_valor_aleatorio_longo"

# Provedor de emissão fiscal (Focus NFe)
# Comece com a URL de homologação para testar sem gerar documentos reais.
# Ambiente do provedor fiscal. Homologação não tem valor fiscal; produção
# emite documento de verdade. O TOKEN É DIFERENTE EM CADA AMBIENTE — trocar
# só a URL e manter o token antigo dá erro de autenticação.
#   Homologação: https://homologacao.focusnfe.com.br
#   Produção:    https://api.focusnfe.com.br
FOCUS_NFE_BASE_URL="https://homologacao.focusnfe.com.br"
FOCUS_NFE_TOKEN="coloque_aqui_o_token_do_provedor"

# Fuso usado na data de emissão dos documentos fiscais. O servidor do Render
# roda em UTC; sem isso a emissão sairia com a hora errada (Mato Grosso é
# UTC-4). Use America/Sao_Paulo se a empresa emitente for de outro estado.
TZ_FISCAL="America/Cuiaba"

# Envio de e-mail (SMTP do domínio). Sem isso, o sistema roda normalmente e
# apenas não envia comprovantes.
SMTP_HOST="mail.seudominio.com.br"
SMTP_PORTA="587"
SMTP_USUARIO="ponto@seudominio.com.br"
SMTP_SENHA="senha_da_caixa"
EMAIL_REMETENTE="Ponto Bionorte <ponto@seudominio.com.br>"

# Comprovante de ponto por e-mail a cada batida. Use "false" para desligar.
EMAIL_COMPROVANTE_PONTO="true"
