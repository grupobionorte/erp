generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoPessoa {
  pessoa_fisica
  pessoa_juridica
}

enum RegimeTributario {
  simples_nacional
  lucro_presumido
  lucro_real
}

enum TipoDocumentoFiscal {
  NFe
  CTe
  MDFe
}

enum StatusDocumentoFiscal {
  rascunho
  enviado
  autorizado
  rejeitado
  cancelado
}

enum TipoCertificado {
  A1
  A3
}

enum PapelUsuario {
  admin
  operador
}

model Usuario {
  id         Int           @id @default(autoincrement())
  nome       String
  email      String        @unique
  senhaHash  String        @map("senha_hash")
  papel      PapelUsuario  @default(operador)
  ativo      Boolean       @default(true)
  criadoEm   DateTime      @default(now()) @map("criado_em")

  // Quais empresas esse usuário pode acessar ao logar. Só vale de verdade
  // pra quem é "operador" — um "admin" enxerga todas as empresas ativas
  // automaticamente, mesmo sem estar nessa lista.
  empresas Empresa[] @relation("UsuarioEmpresas")

  // Vínculo com a ficha de colaborador: é assim que o login de alguém se
  // liga à pessoa real do RH (cargo, setor, CPF). Um colaborador tem no
  // máximo um login, daí o índice único.
  colaboradorId Int?         @unique @map("colaborador_id")
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id])
  tratamentosPonto TratamentoPonto[]

  @@map("usuarios")
}

model Ncm {
  id        Int    @id @default(autoincrement())
  codigo    String @unique
  descricao String

  @@map("ncms")
}

model Cfop {
  id        Int    @id @default(autoincrement())
  codigo    String @unique
  descricao String

  @@map("cfops")
}

model Municipio {
  id         Int    @id @default(autoincrement())
  codigoIbge String @unique @map("codigo_ibge")
  nome       String
  uf         String

  @@index([uf, nome])
  @@map("municipios")
}

model Endereco {
  id                Int      @id @default(autoincrement())
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  uf                String?
  codigoIbgeCidade  String?  @map("codigo_ibge_cidade")

  empresas        Empresa[]
  pessoas         Pessoa[]
  transportadoras Transportadora[]

  @@map("enderecos")
}

model CertificadoDigital {
  id              Int             @id @default(autoincrement())
  tipo            TipoCertificado
  validadeInicio  DateTime?       @map("validade_inicio")
  validadeFim     DateTime?       @map("validade_fim")
  armazenadoEm    String?         @map("armazenado_em")

  empresas Empresa[]

  @@map("certificados_digitais")
}

model Empresa {
  id                Int               @id @default(autoincrement())
  razaoSocial       String            @map("razao_social")
  nomeFantasia      String?           @map("nome_fantasia")
  cnpj              String            @unique
  ie                String?
  im                String?
  // RNTRC — obrigatório pra emitir CTe (modal rodoviário) quando a
  // própria empresa é a transportadora.
  rntrc             String?
  regimeTributario  RegimeTributario  @map("regime_tributario")
  ativo             Boolean           @default(true)

  // Guardada como data URL (base64) direto no banco — simples e
  // suficiente pra uma logo pequena, sem precisar de um serviço de
  // armazenamento de arquivos à parte.
  logoUrl           String?           @map("logo_url")

  // Numeração fiscal — cada empresa (CNPJ) tem sua própria série e
  // contador por tipo de documento. O "próximo número" é incrementado
  // pelo backend a cada emissão real (ainda não implementado).
  nfeSerie            String?  @map("nfe_serie")
  nfeProximoNumero    Int      @default(1) @map("nfe_proximo_numero")
  cteSerie            String?  @map("cte_serie")
  cteProximoNumero    Int      @default(1) @map("cte_proximo_numero")
  mdfeSerie           String?  @map("mdfe_serie")
  mdfeProximoNumero   Int      @default(1) @map("mdfe_proximo_numero")

  enderecoId     Int?                @map("endereco_id")
  endereco       Endereco?           @relation(fields: [enderecoId], references: [id])
  certificadoId  Int?                @map("certificado_id")
  certificado    CertificadoDigital? @relation(fields: [certificadoId], references: [id])

  documentosFiscais DocumentoFiscal[]

  pessoas         Pessoa[]
  colaboradores   Colaborador[]
  transportadoras Transportadora[]
  produtos        Produto[]
  veiculos        Veiculo[]

  usuarios Usuario[] @relation("UsuarioEmpresas")

  reps Rep[]

  @@map("empresas")
}

model Pessoa {
  id               Int        @id @default(autoincrement())
  tipo             TipoPessoa
  nomeRazaoSocial  String     @map("nome_razao_social")
  nomeFantasia     String?    @map("nome_fantasia")
  documento        String
  ie               String?
  ieIsento         Boolean    @default(false) @map("ie_isento")
  // Indicador de IE do destinatário, exigido na NFe: "Contribuinte",
  // "Não Contribuinte" ou "Contribuinte Isento".
  indicadorIe      String?    @map("indicador_ie")
  telefone         String?
  email            String?
  eCliente         Boolean    @default(false) @map("e_cliente")
  eFornecedor      Boolean    @default(false) @map("e_fornecedor")
  ativo            Boolean    @default(true)
  criadoEm         DateTime   @default(now()) @map("criado_em")

  enderecoId Int?     @map("endereco_id")
  endereco   Endereco? @relation(fields: [enderecoId], references: [id])

  // Multi-empresa: registros criados antes dessa coluna existir ficam com
  // empresaId nulo e continuam visíveis pra todo mundo até serem migrados
  // manualmente pra uma empresa específica.
  empresaId Int?     @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  documentosComoDestinatario DocumentoFiscal[]
  documentosComoRemetente    DocumentoFiscal[] @relation("CteRemetente")
  documentosComoExpedidor    DocumentoFiscal[] @relation("CteExpedidor")
  documentosComoRecebedor    DocumentoFiscal[] @relation("CteRecebedor")

  // CPF/CNPJ único por empresa, não mais pro sistema inteiro — assim duas
  // empresas do grupo podem ter o mesmo cliente/fornecedor cadastrado cada
  // uma na sua base, sem conflito.
  @@unique([documento, empresaId])
  @@map("pessoas")
}

model Colaborador {
  id            Int       @id @default(autoincrement())
  nome          String
  cpf           String
  cargo         String?
  setor         String?
  dataAdmissao  DateTime? @map("data_admissao")
  telefone      String?
  email         String?
  ativo         Boolean   @default(true)

  empresaId Int?     @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  documentosComoResponsavel DocumentoFiscal[]
  usuario                   Usuario?
  marcacoesPonto            MarcacaoPonto[]
  jornadas                  JornadaTrabalho[]
  veiculosComoMotorista     Veiculo[]         @relation("VeiculosDoMotorista")
  tratamentosPonto          TratamentoPonto[]
  biometriaFacial           BiometriaFacial?

  // PIN de marcação de ponto: alternativa sempre disponível ao rosto, como
  // exige a portaria (o sistema não pode impedir a marcação). Guardado com
  // hash, nunca em texto puro.
  pinPontoHash String? @map("pin_ponto_hash")

  @@unique([cpf, empresaId])
  @@map("colaboradores")
}

model Transportadora {
  id           Int      @id @default(autoincrement())
  razaoSocial  String   @map("razao_social")
  cnpj         String
  ie           String?
  rntrc        String?
  telefone     String?
  email        String?
  ativo        Boolean  @default(true)

  enderecoId Int?      @map("endereco_id")
  endereco   Endereco? @relation(fields: [enderecoId], references: [id])

  empresaId Int?     @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  veiculos          Veiculo[]
  documentosFiscais DocumentoFiscal[]

  @@unique([cnpj, empresaId])
  @@map("transportadoras")
}

model Veiculo {
  id               Int    @id @default(autoincrement())
  placa            String
  // Como a frota é identificada no dia a dia: "Carreta graneleira 01",
  // "Cavalo Scania vermelho". Ajuda mais que a placa na hora de escolher.
  descricao        String?
  anoFabricacao    Int?   @map("ano_fabricacao")
  anoModelo        Int?   @map("ano_modelo")
  renavam          String?
  taraKg           Float?  @map("tara_kg")
  capacidadeKg     Float?  @map("capacidade_kg")
  // Volume útil da carroceria. Em biomassa importa tanto quanto o peso:
  // cavaco e serragem lotam o volume antes de atingir a capacidade em quilos.
  capacidadeM3     Float?  @map("capacidade_m3")
  tipoRodado       String? @map("tipo_rodado")
  tipoCarroceria   String? @map("tipo_carroceria")
  // UF onde o veículo está licenciado: obrigatória no MDF-e, e nem sempre
  // é a UF da empresa (veículo de agregado, por exemplo).
  ufLicenciamento  String? @map("uf_licenciamento")

  // Propriedade do veículo. "propria" é o padrão; sendo de terceiro, a
  // SEFAZ exige o grupo do proprietário no MDF-e — e é só nesse caso que o
  // tipo de transportador pode ser informado (rejeição 745).
  propriedade              String? @default("propria")
  proprietarioDocumento    String? @map("proprietario_documento")
  proprietarioNome         String? @map("proprietario_nome")
  proprietarioIe           String? @map("proprietario_ie")
  proprietarioUf           String? @map("proprietario_uf")
  proprietarioRntrc        String? @map("proprietario_rntrc")
  // 0 TAC agregado, 1 TAC independente, 2 outros
  proprietarioTipo         String? @map("proprietario_tipo")
  // 1 ETC, 2 TAC, 3 CTC — só vai ao XML quando há proprietário declarado
  tipoTransportador        String? @map("tipo_transportador")
  ativo            Boolean @default(true)

  // Motorista habitual, vindo do cadastro de colaboradores: nome e CPF
  // ficam num lugar só, e o CT-e aproveita os mesmos dados. Os campos de
  // texto abaixo ficaram de versões anteriores e não são mais usados.
  motoristaId   Int?         @map("motorista_id")
  motorista     Colaborador? @relation("VeiculosDoMotorista", fields: [motoristaId], references: [id])
  motoristaNome String?      @map("motorista_nome")
  motoristaCpf  String?      @map("motorista_cpf")

  // Transportadora deixou de ser obrigatória: a frota é própria. O campo
  // fica para o dia em que houver subcontratação ou agregado.
  transportadoraId Int?            @map("transportadora_id")
  transportadora   Transportadora? @relation(fields: [transportadoraId], references: [id])

  empresaId Int?     @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  documentosFiscais DocumentoFiscal[]
  documentosFiscaisReboque  DocumentoFiscal[] @relation("CteVeiculoReboque")
  documentosFiscaisReboque2 DocumentoFiscal[] @relation("CteVeiculoReboque2")
  documentosFiscaisReboque3 DocumentoFiscal[] @relation("CteVeiculoReboque3")

  @@map("veiculos")
}

model Produto {
  id               Int      @id @default(autoincrement())
  codigoInterno    String   @map("codigo_interno")
  descricao        String
  ncm              String
  cest             String?
  cfopPadrao       String?  @map("cfop_padrao")
  unidade          String
  origemMercadoria String?  @map("origem_mercadoria")
  cstIcms          String?  @map("cst_icms")
  csosn            String?
  aliquotaIcms     Float?   @map("aliquota_icms")
  pisCst           String?  @map("pis_cst")
  pisAliquota      Float?   @map("pis_aliquota")
  cofinsCst        String?  @map("cofins_cst")
  cofinsAliquota   Float?   @map("cofins_aliquota")
  // Reforma Tributária (IBS/CBS) — código de 6 dígitos da tabela oficial
  // (cClassTrib) e o CST correspondente (3 primeiros dígitos dele).
  // Confirme com seu contador antes de preencher: o valor certo depende
  // do produto e da operação, não é o mesmo pra todo mundo.
  cstIbsCbs        String?  @map("cst_ibs_cbs")
  classificacaoTributariaIbsCbs String? @map("classificacao_tributaria_ibs_cbs")
  valorUnitario    Float?   @map("valor_unitario")
  pesoLiquidoKg    Float?   @map("peso_liquido_kg")
  ativo            Boolean  @default(true)

  empresaId Int?     @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  itens DocumentoItem[]

  @@unique([codigoInterno, empresaId])
  @@map("produtos")
}

model DocumentoFiscal {
  id                  Int                    @id @default(autoincrement())
  tipo                TipoDocumentoFiscal
  numero               Int?
  serie                Int?
  chaveAcesso          String?                @map("chave_acesso")
  status               StatusDocumentoFiscal  @default(rascunho)
  protocoloAutorizacao String?                @map("protocolo_autorizacao")
  dataEmissao          DateTime               @default(now()) @map("data_emissao")
  dataAutorizacao      DateTime?              @map("data_autorizacao")
  xmlUrl               String?                @map("xml_url")
  pdfUrl               String?                @map("pdf_url")
  motivoRejeicao       String?                @map("motivo_rejeicao")
  // Quantas vezes esse documento já foi mandado ao provedor. A referência
  // enviada à Focus é derivada daqui, então um envio que ficou preso na
  // fila (status "processando" eterno) não bloqueia o documento: a próxima
  // tentativa sai com uma ref nova.
  tentativaEnvio       Int                    @default(1) @map("tentativa_envio")
  justificativaCancelamento String?           @map("justificativa_cancelamento")
  valorTotal           Float?                 @map("valor_total")
  cartasCorrecao       CartaCorrecao[]

  // Cabeçalho da NFe — os campos que faltavam pra virar um cadastro de
  // verdade, e não só um rascunho com cliente + itens.
  naturezaOperacao        String? @map("natureza_operacao")
  modalidadeFrete         String? @map("modalidade_frete")
  dataSaida               DateTime? @map("data_saida")
  informacoesComplementares String? @map("informacoes_complementares")

  // Mais campos de cabeçalho da NFe.
  finalidadeOperacao  String?  @map("finalidade_operacao") // Normal, Devolução, Complementar, Ajuste
  consumidorFinal     Boolean? @default(false) @map("consumidor_final")
  indicadorPresenca   String?  @map("indicador_presenca")  // Presencial, Internet, Teleatendimento, Entrega a domicílio, Não se aplica
  formaPagamento      String?  @map("forma_pagamento")
  valorFrete          Float?   @map("valor_frete")
  valorSeguro         Float?   @map("valor_seguro")
  valorDesconto       Float?   @map("valor_desconto")
  quantidadeVolumes   Int?     @map("quantidade_volumes")
  especieVolumes      String?  @map("especie_volumes")
  pesoBrutoTotal      Float?   @map("peso_bruto_total")
  pesoLiquidoTotal    Float?   @map("peso_liquido_total")
  // Como a carga é medida nesse documento: M3, KG ou TON. É o que decide
  // quais medidas saem no DACTe — cavaco vendido por metro cúbico precisa
  // do volume; vendido por peso, do peso líquido.
  unidadeMedidaCarga  String?  @map("unidade_medida_carga")
  volumeM3Total       Float?   @map("volume_m3_total")

  // Impostos — só ICMS/ICMS ST são informativos (já embutidos no valor
  // do produto); IPI e outras despesas somam no total da nota.
  baseCalculoIcms    Float? @map("base_calculo_icms")
  valorIcms          Float? @map("valor_icms")
  baseCalculoIcmsSt  Float? @map("base_calculo_icms_st")
  valorIcmsSt        Float? @map("valor_icms_st")
  outrasDespesas     Float? @map("outras_despesas")
  valorIpi           Float? @map("valor_ipi")

  // Usados apenas no MDFe — o condutor não tem cadastro próprio no sistema
  // ainda, então guardamos os dados exigidos pela SEFAZ direto aqui.
  nomeMotorista String? @map("nome_motorista")
  cpfMotorista  String? @map("cpf_motorista")
  ufPercurso    String? @map("uf_percurso") // ex: "MT,GO,SP"

  // MDFe — carregamento e descarregamento. A SEFAZ exige município COM
  // código IBGE nos dois lados (o CTe guarda só o nome, por isso os
  // códigos vivem aqui).
  municipioCarregamento         String? @map("municipio_carregamento")
  codigoMunicipioCarregamento   String? @map("codigo_municipio_carregamento")
  municipioDescarregamento      String? @map("municipio_descarregamento")
  codigoMunicipioDescarregamento String? @map("codigo_municipio_descarregamento")

  // MDFe — carga. tipoCarga segue a Resolução ANTT 5.849/2019
  // ("01" granel sólido, "05" carga geral, etc.).
  tipoCarga           String? @map("tipo_carga")
  produtoPredominante String? @map("produto_predominante")
  unidadeMedidaPeso   String? @map("unidade_medida_peso") // "01" KG, "02" TON
  pesoBrutoCarga      Float?  @map("peso_bruto_carga")
  valorTotalCarga     Float?  @map("valor_total_carga")

  // MDFe — seguro da carga, obrigatório no modal rodoviário (Lei 11.442/07).
  seguroResponsavel     String? @map("seguro_responsavel") // "1" emitente, "2" contratante
  seguroNomeSeguradora  String? @map("seguro_nome_seguradora")
  seguroCnpjSeguradora  String? @map("seguro_cnpj_seguradora")
  seguroNumeroApolice   String? @map("seguro_numero_apolice")
  seguroNumeroAverbacao String? @map("seguro_numero_averbacao")

  // MDFe — tipo de emitente ("1" prestador de serviço de transporte,
  // "2" transportador de carga própria) e CIOT.
  tipoEmitenteMdfe String? @map("tipo_emitente_mdfe")
  ciot             String?

  // MDFe — encerramento. Enquanto não for encerrado, a SEFAZ recusa o
  // próximo MDFe da mesma placa.
  dataEncerramento              DateTime? @map("data_encerramento")
  municipioEncerramento         String?   @map("municipio_encerramento")
  codigoMunicipioEncerramento   String?   @map("codigo_municipio_encerramento")

  // Origem/destino do trajeto — usados no CTe (e reaproveitáveis se um dia
  // o MDFe também quiser mostrar cidade em vez de só a lista de UFs).
  origemPercurso  String? @map("origem_percurso")
  destinoPercurso String? @map("destino_percurso")

  empresaId Int     @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  colaboradorResponsavelId Int?         @map("colaborador_responsavel_id")
  colaboradorResponsavel   Colaborador? @relation(fields: [colaboradorResponsavelId], references: [id])

  destinatarioId Int?    @map("destinatario_id")
  destinatario   Pessoa? @relation(fields: [destinatarioId], references: [id])

  // CTe — Remetente, Expedidor e Recebedor são pessoas distintas do
  // Destinatário (que aqui funciona como o "Tomador do serviço" quando a
  // definição do tomador é "Outros"/o próprio destinatário).
  remetenteId Int?    @map("remetente_id")
  remetente   Pessoa? @relation("CteRemetente", fields: [remetenteId], references: [id])
  expedidorId Int?    @map("expedidor_id")
  expedidor   Pessoa? @relation("CteExpedidor", fields: [expedidorId], references: [id])
  recebedorId Int?    @map("recebedor_id")
  recebedor   Pessoa? @relation("CteRecebedor", fields: [recebedorId], references: [id])
  definicaoTomador String? @map("definicao_tomador") // Remetente, Destinatário, Expedidor, Recebedor, Outros
  distanciaKm      Float?  @map("distancia_km")
  ufInicio         String? @map("uf_inicio")
  ufFim            String? @map("uf_fim")

  // Até três reboques: bitrem e rodotrem são comuns no transporte de
  // biomassa, e o MDF-e aceita mais de um engate.
  veiculoReboqueId  Int?     @map("veiculo_reboque_id")
  veiculoReboque    Veiculo? @relation("CteVeiculoReboque", fields: [veiculoReboqueId], references: [id])
  veiculoReboque2Id Int?     @map("veiculo_reboque2_id")
  veiculoReboque2   Veiculo? @relation("CteVeiculoReboque2", fields: [veiculoReboque2Id], references: [id])
  veiculoReboque3Id Int?     @map("veiculo_reboque3_id")
  veiculoReboque3   Veiculo? @relation("CteVeiculoReboque3", fields: [veiculoReboque3Id], references: [id])

  // Tributação da prestação de serviço (CTe) — nível documento, não por
  // item, já que o CTe não tem lista de produtos.
  cfopPrestacao      String? @map("cfop_prestacao")
  cstIcmsPrestacao   String? @map("cst_icms_prestacao")
  baseCalculoIcmsPrestacao Float? @map("base_calculo_icms_prestacao")
  aliquotaIcmsPrestacao    Float? @map("aliquota_icms_prestacao")
  percentualReducaoBaseIcms Float? @map("percentual_reducao_base_icms")
  valorIcmsNaoTributado     Float? @map("valor_icms_nao_tributado")
  valorIcmsOutras           Float? @map("valor_icms_outras")
  valorCreditoPresumidoIcms Float? @map("valor_credito_presumido_icms")
  valorFcp                  Float? @map("valor_fcp")
  // Reforma Tributária (IBS/CBS) do CTe — é no nível do documento (não
  // por item, já que CTe não tem lista de produtos). Confirme com o
  // contador antes de preencher.
  cstIbsCbsPrestacao        String? @map("cst_ibs_cbs_prestacao")
  classificacaoTributariaIbsCbsPrestacao String? @map("classificacao_tributaria_ibs_cbs_prestacao")

  // CT-e — dados de identificação (aba "CT-e" da tela).
  tipoServico      String?   @map("tipo_servico") // Normal, Subcontratação, Redespacho, Redespacho Intermediário, Multimodal
  dataTransporte   DateTime? @map("data_transporte")
  horaTransporte   String?   @map("hora_transporte") // "HH:MM"
  cteGlobalizado   Boolean?  @default(false) @map("cte_globalizado")
  tipoCte          String?   @map("tipo_cte") // CT-e normal, Complemento de Valores, Anulação, Substituto

  transportadoraId Int?            @map("transportadora_id")
  transportadora   Transportadora? @relation(fields: [transportadoraId], references: [id])

  veiculoId Int?     @map("veiculo_id")
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id])

  itens   DocumentoItem[]
  eventos DocumentoEvento[]

  // Um MDFe transporta várias NFe/CTe — cada documento vinculado aponta de
  // volta para o MDFe que o está transportando.
  mdfeId            Int?              @map("mdfe_id")
  mdfe              DocumentoFiscal?  @relation("DocumentosDoMdfe", fields: [mdfeId], references: [id])
  documentosVinculados DocumentoFiscal[] @relation("DocumentosDoMdfe")

  // Um CTe transporta uma ou mais NFe/outros documentos — cada linha na
  // tela "Dados das mercadorias" vira um registro aqui, com todos os
  // campos daquela tela (não é só a chave, tem peso, valores, etc.).
  documentosTransportados CteDocumento[] @relation("DocumentosDoCte")
  cteDocumentosComoNota   CteDocumento[] @relation("CteDocumentoNota")

  @@map("documentos_fiscais")
}

// Um documento (NFe, declaração, etc.) transportado por um CTe — a linha
// da tabela "Dados das mercadorias" na tela do CTe. Quando o tipo é
// "Fiscal" e a nota já existe no sistema, guarda o vínculo com ela
// (notaFiscalId) além de uma cópia dos campos, porque alguns (peso, M3,
// características da carga) são específicos dessa viagem, não da nota em
// si.
model CteDocumento {
  id          Int             @id @default(autoincrement())
  cteId       Int             @map("cte_id")
  cte         DocumentoFiscal @relation("DocumentosDoCte", fields: [cteId], references: [id], onDelete: Cascade)
  notaFiscalId Int?           @map("nota_fiscal_id")
  notaFiscal  DocumentoFiscal? @relation("CteDocumentoNota", fields: [notaFiscalId], references: [id])

  tipo                String  @default("Fiscal") // Fiscal, Declaração, Dutoviário, CF-e SAT, Outros
  chaveAcesso         String? @map("chave_acesso")
  numeroDocumento     String? @map("numero_documento")
  modelo              String?
  serie               String?
  cfopPredominante    String? @map("cfop_predominante")
  dataEmissao         DateTime? @map("data_emissao")
  naturezaMercadoria  String? @map("natureza_mercadoria")
  outrasCaracteristicasCarga String? @map("outras_caracteristicas_carga")

  baseCalculoIcms     Float?  @map("base_calculo_icms")
  valorIcms           Float?  @map("valor_icms")
  baseCalculoIcmsSt   Float?  @map("base_calculo_icms_st")
  valorIcmsSt         Float?  @map("valor_icms_st")
  valorTotalProdutos  Float?  @map("valor_total_produtos")
  valorTotalNota      Float?  @map("valor_total_nota")

  pesoBruto           Float?  @map("peso_bruto")
  m3                  Float?
  quantidadeVolumes   Float?  @map("quantidade_volumes")
  pesoLiquido         Float?  @map("peso_liquido")

  pinSuframa          String? @map("pin_suframa")
  numeroPedido        String? @map("numero_pedido")
  numeroRomaneio      String? @map("numero_romaneio")
  valorCargaAverbacao Float?  @map("valor_carga_averbacao")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("cte_documentos")
}

// Carta de Correção Eletrônica (CC-e) — histórico de correções feitas
// numa NFe já autorizada. A SEFAZ permite até 20 por nota, cada uma
// substituindo o entendimento das anteriores (não apaga, só complementa).
model CartaCorrecao {
  id               Int      @id @default(autoincrement())
  documentoId      Int      @map("documento_id")
  documento        DocumentoFiscal @relation(fields: [documentoId], references: [id])
  numeroSequencial Int?     @map("numero_sequencial")
  texto            String
  status           String   @default("pendente") // pendente | registrada | erro
  motivoErro       String?  @map("motivo_erro")
  pdfUrl           String?  @map("pdf_url")
  criadoEm         DateTime @default(now()) @map("criado_em")

  @@map("cartas_correcao")
}

model DocumentoItem {
  id             Int   @id @default(autoincrement())
  quantidade     Float
  valorUnitario  Float @map("valor_unitario")
  valorTotal     Float @map("valor_total")
  cfopUtilizado  String? @map("cfop_utilizado")
  ncmUtilizado   String? @map("ncm_utilizado")
  cstUtilizado   String? @map("cst_utilizado")

  documentoId Int             @map("documento_id")
  documento   DocumentoFiscal @relation(fields: [documentoId], references: [id])

  produtoId Int     @map("produto_id")
  produto   Produto @relation(fields: [produtoId], references: [id])

  @@map("documento_itens")
}

model DocumentoEvento {
  id             Int      @id @default(autoincrement())
  tipoEvento     String   @map("tipo_evento")
  justificativa  String?
  dataEvento     DateTime @default(now()) @map("data_evento")
  protocolo      String?

  documentoId Int             @map("documento_id")
  documento   DocumentoFiscal @relation(fields: [documentoId], references: [id])

  @@map("documento_eventos")
}

// ---------------------------------------------------------------------------
// Controle de ponto — Portaria MTP 671/2021
//
// Regra que governa este bloco: marcação de ponto NÃO se altera nem se apaga.
// A tabela de marcações é somente-inserção; qualquer correção vira um
// registro de tratamento, que fica ao lado da marcação original sem
// substituí-la. Por isso não existe rota de PUT/DELETE para marcações.
// ---------------------------------------------------------------------------

// Cada tablet em operação é um REP (registrador). O NSR é sequencial por
// REP, o que permite o tablet numerar suas marcações mesmo offline.
model Rep {
  id            Int       @id @default(autoincrement())
  identificador String    @unique                      // ex.: "TABLET-PATIO-01"
  // Credencial do aparelho: o tablet não faz login de usuário, ele se
  // identifica com este token. Se o tablet sumir, revoga-se o REP.
  token         String    @unique
  descricao     String?
  localizacao   String?
  ultimoNsr     Int       @default(0) @map("ultimo_nsr")
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now()) @map("criado_em")

  empresaId Int?     @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  marcacoes MarcacaoPonto[]

  @@map("reps")
}

model MarcacaoPonto {
  id Int @id @default(autoincrement())

  // Identificação exigida no AFD.
  nsr       Int                                        // sequencial dentro do REP
  repId     Int      @map("rep_id")
  rep       Rep      @relation(fields: [repId], references: [id])
  cpf       String                                     // gravado junto: o AFD usa o CPF
  dataHora  DateTime @map("data_hora")                 // momento da batida, com fuso

  colaboradorId Int         @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  // Como a pessoa foi identificada e onde a batida nasceu.
  metodoIdentificacao String  @map("metodo_identificacao") // facial | pin
  origemOffline       Boolean @default(false) @map("origem_offline")
  sincronizadoEm      DateTime? @map("sincronizado_em")

  // Identificador gerado no tablet: garante que reenviar o lote não duplica
  // a batida quando a conexão cai no meio do envio.
  idLocal String @unique @map("id_local")

  // Integridade: cada marcação carrega o hash da anterior do mesmo REP.
  // Alterar ou remover uma marcação antiga quebra a corrente e fica visível.
  hashAnterior String? @map("hash_anterior")
  hash         String

  criadoEm DateTime @default(now()) @map("criado_em")

  tratamentos TratamentoPonto[]

  @@unique([repId, nsr])
  @@index([colaboradorId, dataHora])
  @@map("marcacoes_ponto")
}

// Correções e inclusões do fechamento (o "tratamento" da portaria). Nunca
// tocam na marcação original — ficam ao lado dela, com autor e motivo.
model TratamentoPonto {
  id            Int      @id @default(autoincrement())
  tipo          String                                  // inclusao | desconsideracao | pre_assinalado
  dataHora      DateTime @map("data_hora")
  motivo        String
  criadoEm      DateTime @default(now()) @map("criado_em")

  colaboradorId Int         @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  marcacaoId Int?           @map("marcacao_id")
  marcacao   MarcacaoPonto? @relation(fields: [marcacaoId], references: [id])

  autorId Int?     @map("autor_id")
  autor   Usuario? @relation(fields: [autorId], references: [id])

  @@index([colaboradorId, dataHora])
  @@map("tratamentos_ponto")
}

// Biometria facial: guardamos o vetor (embedding) gerado no tablet, nunca a
// foto. Dado sensível pela LGPD — daí o registro de consentimento junto.
model BiometriaFacial {
  id            Int      @id @default(autoincrement())
  colaboradorId Int      @unique @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  vetor           Json                                  // embedding do rosto
  versaoModelo    String   @map("versao_modelo")
  consentimentoEm DateTime @map("consentimento_em")
  consentimentoTexto String @map("consentimento_texto")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  @@map("biometrias_faciais")
}

// Jornada de trabalho do colaborador. Guardada com vigência: quando o
// horário de alguém muda, a jornada antiga continua valendo para os meses
// já fechados — recalcular o passado com a regra nova bagunçaria
// fechamento que já foi pago.
model JornadaTrabalho {
  id   Int    @id @default(autoincrement())
  tipo String @default("escala")            // escala | semanal

  colaboradorId Int         @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  vigenciaInicio DateTime  @map("vigencia_inicio")
  vigenciaFim    DateTime? @map("vigencia_fim")

  toleranciaMinutos Int @default(10) @map("tolerancia_minutos")

  // Escala por ciclo (6x1, 5x2...). O deslocamento é o que faz a folga
  // revezar: 0 mantém a folga no mesmo dia da semana.
  diasTrabalho         Int?      @map("dias_trabalho")
  diasFolga            Int?      @map("dias_folga")
  deslocamentoPorCiclo Int       @default(0) @map("deslocamento_por_ciclo")
  dataReferencia       DateTime? @map("data_referencia")

  // Horários do dia trabalhado na escala (formato "HH:MM").
  entrada         String?
  intervaloInicio String? @map("intervalo_inicio")
  intervaloFim    String? @map("intervalo_fim")
  saida           String?

  dias JornadaDia[]

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([colaboradorId, vigenciaInicio])
  @@map("jornadas_trabalho")
}

// Usado quando o tipo é "semanal": um horário por dia da semana.
model JornadaDia {
  id        Int             @id @default(autoincrement())
  jornadaId Int             @map("jornada_id")
  jornada   JornadaTrabalho @relation(fields: [jornadaId], references: [id], onDelete: Cascade)

  diaSemana Int     @map("dia_semana")        // 0 = domingo
  folga     Boolean @default(false)

  entrada         String?
  intervaloInicio String? @map("intervalo_inicio")
  intervaloFim    String? @map("intervalo_fim")
  saida           String?

  @@unique([jornadaId, diaSemana])
  @@map("jornadas_dias")
}
